    "test:boost": "node tests/windmill_boost.js 300",
    "test:p2": "node tests/p2_tests.js",
    "tournament": "node build_all.js --competition config/competitions/ucl_2026_top16.json",
    "preview": "node build_all.js --competition config/competitions/ucl_2026_top16.json --preview",
    "reels": "node build_reels.js",
    "test:p3": "node tests/p3_tests.js",
    "plan:validate": "node plan/validate.js",
    "generate": "node generate.js",
    "next": "node next.js",
    "preflight": "node preflight.js",
    "test:p4": "node tests/p4_tests.js",
    "test:p5": "node tests/p5_tests.js",
    "pump:measure": "node tests/pump_measure.js 200",
    "diag:p5": "node tools/p5_diag.js",
    "test:p6": "node tests/p6_tests.js",
    "players:check": "node sim/players.js",
    "test:p7": "node tests/p7_tests.js",
    "league": "node league.js",
    "league:calibrate": "node tools/league_calibrate.js",
    "league:dryrun": "node league.js dry-run"
